# ===============================
# Istidlal Blog Environment
# ===============================

APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-key
DEFAULT_LANG=ar
HOST=127.0.0.1
PORT=5000

# ===============================
# Development SQLite
# ===============================
# Leave DATABASE_URL empty to use: instance/datablog.sqlite
# DATABASE_URL=sqlite:///instance/datablog.sqlite

# ===============================
# Production Database
# ===============================
# Preferred: use one full SQLAlchemy URL:
# DATABASE_URL=mysql+pymysql://istidlal_user:strong_password@127.0.0.1:3306/istidlal_blog?charset=utf8mb4

# If DATABASE_URL is empty and APP_ENV=production, the app builds the MySQL URL from these values:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=istidlal_blog
MYSQL_USER=istidlal_user
MYSQL_PASSWORD=strong_password
MYSQL_CHARSET=utf8mb4

DB_POOL_RECYCLE=280
MAX_CONTENT_LENGTH=5242880

# ===============================
# Security / CSRF / Session / Rate limiting
# ===============================
WTF_CSRF_TIME_LIMIT=3600
WTF_CSRF_SSL_STRICT=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=43200
SECURITY_HEADERS_ENABLED=True

# Use Redis in production for shared rate limits across workers, e.g. redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://

# ===============================
# Internal visitor analytics
# ===============================
INTERNAL_ANALYTICS_ENABLED=True
ANALYTICS_RESPECT_DNT=True
# Optional. If empty, SECRET_KEY is used for analytics hashing.
ANALYTICS_HASH_SECRET=

# ===============================
# Default admin seed
# ===============================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@datablog.local
ADMIN_PASSWORD=change-this-admin-password
